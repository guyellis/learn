  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "coverage:view": "google-chrome coverage/lcov-report/index.html",
    "coverage": "tsc && vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "lintfix": "npm run lint -- --fix",
    "test": "npm run lint && tsc && vitest run --coverage && npm run build",
    "test:u": "vitest run -u",
    "test:update": "vitest run -u",
    "prepare": "husky"
  },
  "version": "0.0.2",
  "type": "module",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
