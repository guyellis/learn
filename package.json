    "test:update": "vitest run -u",
    "prepare": "husky"
  },
  "version": "0.0.2",
  "type": "module",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "eslint": "$eslint"
  }
